// fonction pour enregistrer le score 
void enrg_score(const char*nom,int score ){
    FILE*fichier=fopen("scores.txt","a"); // ouvre le fichier en mode ajout (apprend)
    
    if (fichier==NULL){ //verifie si le fichier est ouvert 
        printf("erreur d'ouverture\n");
        return ;
    }
    
    time_t tps=time(NULL); // recuperer l'heure
    struct tm*tm_info=localtime(&tps);
    char date_heure[30];
    strftime((date_heure),sizeof(date_heure),"%d/%m/%Y %H:%M:%S",tm_info);
    //enregistre dans fichier
    fprintf(fichier,"nom:%s\n",nom);
    fprintf(fichier,"date et heure : %s\n",date_heure);
    fprintf(fichier,"score: %d\n\n",score);
    // fermer le fichier
    fclose(fichier);
    printf("votre score a été enregistré\n");
}
int changer_score(const char* nom) {
    FILE* fichier = fopen(file_name, "r"); // ouvre en lecture
    if (fichier == NULL) {
        return 0;  // Aucun fichier donc aucun score
    }
    char ligne[100];
    char nom_lu[max_nom];
    int score = 0;
    int score_trouve = 0;
    
    while(fgets(ligne,sizeof(ligne),fichier)){
        if (sscanf(ligne,"nom:%s",nom_lu)==1){ //cherche une ligne avec un nom
            if(strcmp(nom,nom_lu)==0){ // si le nom correspond
                fgets(ligne,sizeof(ligne),fichier); // passe la ligne date
                fgets(ligne,sizeof(ligne),fichier); // passe la ligne "score"
                sscanf(ligne,"score: %d",&score); // extrait le score
                }
            }
        }
    fclose (fichier); 
    return score;
}
